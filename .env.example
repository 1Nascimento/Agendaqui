DATABASE_URL="postgresql://agendaqui:agendaqui@localhost:5432/agendaqui?schema=public"
APP_URL="http://localhost:3000"
SESSION_COOKIE_NAME="agendaqui_session"
PASSWORD_RESET_TOKEN_MINUTES="60"

# Optional e-mail adapter. Without EMAIL_WEBHOOK_URL the reset link is printed in the server log.
EMAIL_FROM="Agendaqui <nao-responda@agendaqui.local>"
EMAIL_WEBHOOK_URL=""

# Prisma seed for the first administrator. Use real values only in your local .env.
ADMIN_SEED_NOME="Administrador Agendaqui"
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_TELEFONE="65999999999"
ADMIN_SEED_SENHA="TroqueEstaSenha123"
