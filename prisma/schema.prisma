generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PerfilConta {
  CLIENTE
  FUNCIONARIO
  ADMINISTRADOR
}

model Empresa {
  id           String @id @default(cuid())
  nome         String
  slug         String @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  contas       Conta[]
  servicos     Servico[]
  agendamentos Agendamento[]
  expedientes  ExpedienteFuncionario[]
}

model Conta {
  empresaId        String?
  empresa          Empresa? @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  id               String                    @id @default(cuid())
  nome             String
  email            String                    @unique
  telefone         String
  senhaHash        String
  perfil           PerfilConta
  ativo            Boolean                   @default(true)
  emailVerificado  Boolean                   @default(false)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  sessoes          SessaoConta[]
  tokensSenha      TokenRecuperacaoSenha[]
  agendamentosCliente Agendamento[] @relation("ClienteAgendamento")
  agendamentosFuncionario Agendamento[] @relation("FuncionarioAgendamento")
  eventosAgendamento EventoAgendamento[]
  pagamentosRegistrados Pagamento[] @relation("PagamentoRegistrador")
  pagamentosEstornados Pagamento[] @relation("PagamentoEstornador")
  expedientes ExpedienteFuncionario[]

  @@index([perfil])
  @@index([ativo])
  @@unique([id, empresaId])
  @@index([empresaId, perfil, ativo])
}

model SessaoConta {
  id          String    @id @default(cuid())
  contaId     String
  tokenHash   String    @unique
  expiraEm    DateTime
  revogadaEm  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  conta       Conta     @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@index([contaId])
  @@index([expiraEm])
}

model TokenRecuperacaoSenha {
  id          String    @id @default(cuid())
  contaId     String
  tokenHash   String    @unique
  expiraEm    DateTime
  utilizadoEm DateTime?
  createdAt   DateTime  @default(now())

  conta       Conta     @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@index([contaId])
  @@index([expiraEm])
}

model Servico {
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  id        String   @id @default(cuid())
  nome      String
  descricao String?
  preco     Decimal  @db.Decimal(10, 2)
  duracao   Int
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agendamentos AgendamentoServico[]

  @@index([ativo])
  @@index([empresaId, ativo])
}

enum StatusAgendamento {
  CONFIRMADO
  CANCELADO
  REALIZADO
  NAO_COMPARECEU
}

model ExpedienteFuncionario {
  empresaId     String
  empresa       Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  id            String @id @default(cuid())
  funcionarioId String
  diaSemana     Int
  inicioMinuto  Int
  fimMinuto     Int
  funcionario   Conta @relation(fields: [funcionarioId, empresaId], references: [id, empresaId], onDelete: Cascade, onUpdate: Restrict)

  @@unique([funcionarioId, diaSemana])
  @@index([empresaId, funcionarioId])
}

enum TipoEventoAgendamento {
  CONFIRMADO
  REMARCADO
  CANCELADO
  REALIZADO
  NAO_COMPARECEU
}

model Agendamento {
  empresaId     String
  empresa       Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  id            String @id @default(cuid())
  clienteId     String
  funcionarioId String
  inicio        DateTime
  fim           DateTime
  status        StatusAgendamento @default(CONFIRMADO)
  versao        Int @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  cliente       Conta @relation("ClienteAgendamento", fields: [clienteId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  funcionario   Conta @relation("FuncionarioAgendamento", fields: [funcionarioId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  servicos      AgendamentoServico[]
  eventos       EventoAgendamento[]
  pagamentos    Pagamento[]

  @@unique([id, empresaId])
  @@index([funcionarioId, status, inicio, fim])
  @@index([clienteId, status, inicio, fim])
  @@index([empresaId, status, inicio])
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
}

// Recebimentos manuais imutáveis. Estornos preservam valor, autor e motivo.
model Pagamento {
  id             String @id @default(cuid())
  empresaId      String
  agendamentoId  String
  valor          Decimal @db.Decimal(10, 2)
  forma          FormaPagamento
  registradoPorId String
  createdAt      DateTime @default(now())
  estornadoEm    DateTime?
  estornadoPorId String?
  motivoEstorno  String?
  agendamento    Agendamento @relation(fields: [agendamentoId, empresaId], references: [id, empresaId], onDelete: Cascade, onUpdate: Restrict)
  registradoPor  Conta @relation("PagamentoRegistrador", fields: [registradoPorId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  estornadoPor   Conta? @relation("PagamentoEstornador", fields: [estornadoPorId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)

  @@index([empresaId, createdAt])
  @@index([agendamentoId])
}

// Cópias do nome, preço e duração preservam as condições da confirmação.
model AgendamentoServico {
  id            String @id @default(cuid())
  agendamentoId String
  servicoId     String?
  nome          String
  preco         Decimal @db.Decimal(10, 2)
  duracao       Int
  agendamento   Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  servico       Servico? @relation(fields: [servicoId], references: [id], onDelete: SetNull)

  @@index([agendamentoId])
  @@index([servicoId])
}

model EventoAgendamento {
  id             String @id @default(cuid())
  agendamentoId  String
  atorId         String
  tipo           TipoEventoAgendamento
  inicio         DateTime
  fim            DateTime
  inicioAnterior DateTime?
  fimAnterior    DateTime?
  createdAt      DateTime @default(now())
  agendamento    Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  ator           Conta @relation(fields: [atorId], references: [id], onDelete: Restrict)

  @@index([agendamentoId, createdAt])
  @@index([atorId])
}
